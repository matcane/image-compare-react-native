{
  "name": "@image-compare/react-native",
  "version": "0.1.0",
  "description": "Before/after image comparison slider for React Native and Expo, with a customizable handle.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matcane/image-compare-react-native.git"
  },
  "homepage": "https://github.com/matcane/image-compare-react-native#readme",
  "bugs": {
    "url": "https://github.com/matcane/image-compare-react-native/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "image-comparison",
    "image-comparison-slider",
    "before-after",
    "before-after-slider",
    "comparison-slider",
    "image-slider"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.8.0",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "image-compare-react-native-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!lib/**/*.test.js",
    "!lib/**/*.test.js.map"
  ],
  "scripts": {
    "prepare": "bob build",
    "release": "release-it",
    "dev": "pnpm --filter example start",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "expo-image": ">=2.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.4.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "catalog:",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "expo-image": "catalog:",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "prettier": "^3.9.6",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "^0.43.0",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-worklets": "catalog:",
    "release-it": "^21.0.2",
    "typescript": "catalog:"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/*.{test.ts,test.tsx}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md"
      }
    }
  }
}
